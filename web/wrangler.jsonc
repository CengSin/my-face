{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-face-weather",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-08-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/favicon.svg",
      "!/icons.svg",
      "!/og-image.jpg"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-face-journal",
      "database_id": "613d21dc-fa66-4bce-97b8-1ddde3676e7c",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "observability": {
    "enabled": false
  },
  "account_id": "0b6decfbed0f3439726d7ded971b57e5",
  "vars": {
    "PUBLIC_ORIGIN": "https://mood.z-agent.ccwu.cc"
  },
  "routes": [
    {
      "pattern": "mood.z-agent.ccwu.cc",
      "custom_domain": true,
      "zone_id": "6da3642de0e20ba9ed08db3cff81b8f0"
    }
  ]
}

{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx --tsconfig tsconfig.app.json --test tests/*.test.mjs",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "cf:dev": "wrangler dev --ip 127.0.0.1 --port 8787 --var ALLOW_LOCAL_DEV:true --var PUBLIC_ORIGIN:http://127.0.0.1:8787",
    "cf:credentials": "node cloudflare/credentials.mjs",
    "cf:secret": "node cloudflare/put-secret.mjs",
    "cf:export": "node cloudflare/export-posts.mjs",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:check": "wrangler deploy --dry-run --outdir .cloudflare-build",
    "test:cloudflare": "npm run build && npm run cf:check && node --test cloudflare/tests/*.test.mjs",
    "cf:deploy": "npm run build && node cloudflare/deploy.mjs",
    "cf:preview": "npm run cf:check && node cloudflare/test-preview.mjs",
    "cf:verify": "node cloudflare/verify-live.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "miniflare": "^5.20260828.0-alpha",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
